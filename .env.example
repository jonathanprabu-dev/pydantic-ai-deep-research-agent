# Which model to run, as "<provider>:<model name>".
# Only the first colon splits the provider, so OpenRouter's ":free" suffix is fine.
MODEL=openrouter:nvidia/nemotron-3-super-120b-a12b:free

# Needed when MODEL starts with "openrouter:".
# Free key from https://openrouter.ai/settings/keys
# Free models allow 50 requests/day (1000 if you've ever bought $10 of credits).
OPENROUTER_API_KEY=your-key-here

# Needed when MODEL starts with "google:".
# Free key from https://aistudio.google.com/apikey
# Free tier allows 20 requests/day PER PROJECT, so a second key in the same
# project shares the same spent quota. Paste the key exactly as issued.
# GOOGLE_API_KEY=your-key-here
